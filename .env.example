# Configuración de la aplicación
# ==============================

# Modo debug (False en producción)
FLASK_DEBUG=False
FLASK_ENV=production
SECRET_KEY=tu_clave_secreta_muy_segura_cambiar_en_produccion
WTF_CSRF_SECRET_KEY=otra_clave_secreta_para_csrf

# Base de datos MySQL
# ===================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=kakebo_user
MYSQL_PASSWORD=contraseña_segura
MYSQL_DB=kakebo_db
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DB}

# Redis (para caché y rate limiting)
# ===================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Configuración de seguridad
# ===========================
BCRYPT_LOG_ROUNDS=12
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600  # 1 hora en segundos

# Rate limiting
# ==============
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Configuración de logs
# ======================
LOG_LEVEL=INFO
LOG_FILE=logs/kakebo.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=10

# Configuración de email (para recuperación de contraseña)
# ==========================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_contraseña
MAIL_DEFAULT_SENDER=noreply@kakebo.com

# Configuración de la aplicación
# ==============================
APP_NAME=Kakebo
APP_VERSION=1.0.0
DEFAULT_LANGUAGE=es
TIMEZONE=Europe/Madrid

# URLs
# =====
BASE_URL=http://localhost:5000
STATIC_URL=/static
MEDIA_URL=/media